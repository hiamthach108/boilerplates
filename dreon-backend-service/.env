APP_NAME=dreon-backend-service
APP_VERSION=1.0.0
HTTP_HOST=localhost
HTTP_PORT=8080
GRPC_PORT=9090

LOG_LEVEL=info

CACHE_DEFAULT_EXPIRE_TIME_SEC=3600
CACHE_CLEANUP_INTERVAL_HOUR=24
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

POSTGRES_CONNECTION_NAME=
